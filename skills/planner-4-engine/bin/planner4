#!/usr/bin/env python3
"""planner4 - one-click entry point for the Planner AI 4.0 engine (Linux, macOS, WSL2; Windows uses planner4.bat).

    planner4 compile plan.yaml --out .planner/tickets --board .planner/board.db   plan -> signed Contract-First tickets (dag_planner.py)
    planner4 view   --root .                 waves, workers, tiers, ports           (orchestrator.py plan)
    planner4 run    --root . --executor antigravity --cmd "<your headless agent command>" --lead 1 --standby   (orchestrator.py run)
    planner4 status --root .                 blackboard state of every ticket       (orchestrator.py status)
    planner4 verify run --ticket T --scope worker_backend --root .                  (verifier.py)
    planner4 swarm parallel --spec tasks.json                                       (swarm.py)
    planner4 fleet table | ports AG3 T-1 | scan AG5 . file.js                       (core/fleet.py)
    planner4 bridge profiles | check | env --worker AG3                             (core/antigravity_bridge.py)
    planner4 golden                          end-to-end golden benchmark in a temp workspace (evals/golden_e2e_run.py)
    planner4 test                            the whole unit-test suite
    planner4 doctor                          where the engine is, versions, optional tools, account profiles
    planner4 where                           print the engine root

Every other argument is forwarded untouched and the exit code of the engine script is returned.

Where is the engine? In this order: $PLANNER4_HOME; the repository this file lives in (skills/planner-4-engine/bin/ ->
three levels up); an `engine/` folder next to SKILL.md (a bundled copy). A directory counts only if it contains
orchestrator.py, swarm.py, verifier.py, dag_planner.py and core/fleet.py. Standard library only; Python 3.10+.
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import List, Optional, Sequence

REQUIRED = ("orchestrator.py", "swarm.py", "verifier.py", "dag_planner.py", os.path.join("core", "fleet.py"))
HERE = Path(__file__).resolve().parent


def is_engine(path) -> bool:
    p = Path(path)
    return p.is_dir() and all((p / r).is_file() for r in REQUIRED)


def candidates(env: Optional[dict] = None) -> List[Path]:
    env = os.environ if env is None else env
    out: List[Path] = []
    if env.get("PLANNER4_HOME"):
        out.append(Path(env["PLANNER4_HOME"]).expanduser())
    out.append(HERE.parent.parent.parent)       # <repo>/skills/planner-4-engine/bin/planner4
    out.append(HERE.parent / "engine")          # bundled copy next to SKILL.md
    return out


def find_engine(env: Optional[dict] = None) -> Optional[Path]:
    for c in candidates(env):
        if is_engine(c):
            return c.resolve()
    return None


# subcommand -> (script relative to the engine root, fixed leading args)
ROUTES = {
    "compile": ("dag_planner.py", []),
    "view": ("orchestrator.py", ["plan"]),
    "run": ("orchestrator.py", ["run"]),
    "status": ("orchestrator.py", ["status"]),
    "orch": ("orchestrator.py", []),
    "verify": ("verifier.py", []),
    "swarm": ("swarm.py", []),
    "fleet": (os.path.join("core", "fleet.py"), []),
    "bridge": (os.path.join("core", "antigravity_bridge.py"), []),
    "golden": (os.path.join("evals", "golden_e2e_run.py"), []),
}
USAGE = (__doc__ or "planner4").strip()


def build_command(argv: Sequence[str], engine: Path, python: str = sys.executable) -> Optional[List[str]]:
    """argv[0] is the subcommand. Returns the command line to execute, or None for subcommands handled in-process."""
    sub = argv[0]
    if sub == "test":
        return [python, "-m", "unittest", "discover", "tests", *argv[1:]]
    if sub in ROUTES:
        script, lead = ROUTES[sub]
        return [python, str(engine / script), *lead, *argv[1:]]
    return None


def doctor(engine: Optional[Path], out=sys.stdout) -> int:
    ok = True

    def line(flag: str, text: str) -> None:
        print(f"[{flag}] {text}", file=out)

    line("ok" if sys.version_info >= (3, 10) else "FAIL", f"python {sys.version.split()[0]} (3.10+ required)")
    ok &= sys.version_info >= (3, 10)
    if engine is None:
        line("FAIL", "engine not found: set PLANNER4_HOME to the planner-system-4.0 folder")
        return 1
    line("ok", f"engine: {engine}")
    sys.path.insert(0, str(engine))
    try:
        from core import fleet  # type: ignore
        problems = fleet.validate_table()
        line("ok" if not problems else "FAIL", f"fleet table: {len(fleet.FLEET)} workers, MASP ranges {'consistent' if not problems else problems}")
        ok &= not problems
    except Exception as exc:  # pragma: no cover - defensive
        line("FAIL", f"cannot import core.fleet: {exc}")
        ok = False
    for exe, why in (("node", "UI linter, Stryker"), ("ast-grep", "structural queries (the binary is `ast-grep`; `sg` is often shadow-utils)"),
                     ("git", "worktrees")):
        found = shutil.which(exe)
        line("ok" if found else "--", f"{exe}: {found or 'not found'} ({why}; optional)")
    try:
        from core import antigravity_bridge as br  # type: ignore
        table = br.profile_table()
        missing = br.missing_profiles(table=table)
        line("ok" if not missing else "--", f"account profiles on this machine ({br.detect_os()}): "
                                           f"{'all 8 present' if not missing else 'missing ' + ', '.join(missing)}")
    except Exception as exc:  # pragma: no cover - defensive
        line("--", f"profile probe failed: {exc}")
    key = "set" if os.environ.get("PLANNER_LAWGIVER_KEY") else "not set (sha256 tamper-evidence only; hmac needs the key)"
    line("ok" if key == "set" else "--", f"PLANNER_LAWGIVER_KEY: {key}")
    return 0 if ok else 1


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE)
        print("\nsubcommands: " + ", ".join(sorted(list(ROUTES) + ["test", "doctor", "where"])))
        return 0
    sub = args[0]
    engine = find_engine()
    if sub == "doctor":
        return doctor(engine)
    if engine is None:
        print("planner4: cannot find the Planner 4.0 engine. Set PLANNER4_HOME to the planner-system-4.0 folder "
              "(it must contain orchestrator.py, swarm.py, verifier.py, dag_planner.py and core/fleet.py).", file=sys.stderr)
        return 2
    if sub == "where":
        print(engine)
        return 0
    cmd = build_command(args, engine)
    if cmd is None:
        print(f"planner4: unknown subcommand {sub!r}; run `planner4 help`", file=sys.stderr)
        return 2
    cwd = str(engine) if sub in ("test", "golden") else None  # `test` and `golden` belong to the engine tree; the rest run where you are
    env = dict(os.environ)
    env["PYTHONPATH"] = str(engine) + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    try:
        return subprocess.call(cmd, cwd=cwd, env=env)
    except KeyboardInterrupt:
        return 130
    except OSError as exc:
        print(f"planner4: cannot start {cmd[0]}: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
